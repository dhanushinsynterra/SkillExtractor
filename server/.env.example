# Gemini API key (https://aistudio.google.com/apikey). Can also be set in Admin → Settings.
GEMINI_API_KEY=

# Password for the admin console. Required anywhere other than your own machine.
ADMIN_PASSWORD=

# Port the API/WebSocket server listens on (Nginx or Vite proxy to it).
SERVER_PORT=8787

# Optional: pin models instead of auto-selecting the newest available.
# GEMINI_LIVE_MODEL=
# GEMINI_REPORT_MODEL=
# GEMINI_VOICE=Kore
